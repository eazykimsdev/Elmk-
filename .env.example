# ==============================================================================
# ConnectingERLC Platform Environment Configuration
# Target Domain: https://connectingerlc.xyz
# ==============================================================================

# Core Site & Origin Configuration
# In production, must start with https:// and match your verified domain
SITE_URL=https://connectingerlc.xyz
APP_ORIGIN=https://connectingerlc.xyz
SUPPORT_INVITE_URL=https://discord.gg/connectingerlc

# Discord OAuth2 Credentials
# Found under Discord Developer Portal > Applications > ConnectingERLC > OAuth2
DISCORD_CLIENT_ID=your_discord_application_client_id_here
DISCORD_CLIENT_SECRET=your_discord_application_client_secret_here
DISCORD_REDIRECT_URI=https://connectingerlc.xyz/auth/discord/callback

# Discord Bot Token
# Found under Discord Developer Portal > Applications > ConnectingERLC > Bot
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# PostgreSQL Database Connection URL
# On Railway, provided automatically by connecting a Postgres service plugin:
# postgresql://postgres:password@postgres.railway.internal:5432/railway
DATABASE_URL=postgresql://user:password@host:5432/connectingerlc

# Session and Encryption Secrets
# Generate random 64-character hex strings (e.g. using: node -e "console.log(crypto.randomBytes(32).toString('hex'))")
SESSION_SECRET=your_random_64_character_session_secret_hex_string_here
ENCRYPTION_KEY=your_random_32_byte_aes_encryption_key_hex_string_here

# Platform Administration
# Comma-separated Discord User Snowflake IDs granted Administrator Portal access
# Example: ADMIN_DISCORD_IDS=523693281541095424,123456789012345678
ADMIN_DISCORD_IDS=523693281541095424

# Automated System Status Alerts
# Comma-separated Discord User Snowflake IDs who receive instant Components V2 direct messages upon outage detection
# Example: ALERT_DISCORD_IDS=523693281541095424
ALERT_DISCORD_IDS=523693281541095424

# Fallback Alert Webhook (optional)
# Used if Discord DM channels are closed or bot cannot deliver direct message
# ALERT_WEBHOOK_URL=https://discord.com/api/webhooks/123456789/abcdef...

# Railway Dashboard Management URL (optional)
# Linked on system alert Components V2 buttons for one-click deployment rollbacks
# RAILWAY_DASHBOARD_URL=https://railway.com/project/your-project-id

# Platform Launch Countdown (ISO 8601 in UTC)
LAUNCH_AT=2026-11-21T07:27:00.000Z
VITE_LAUNCH_AT=2026-11-21T07:27:00.000Z

# Port & Node Environment
PORT=3001
NODE_ENV=production
